# Chart source — Deezer Global 50 (no auth required)
CHART_SOURCE="https://api.deezer.com/chart/0/tracks"

# Label written to the chart_source column in the CSV
CHART_REGION="Global"

# How many chart rows to fetch and write per run
MAX_ROWS=50

# DEFERRED FOR FUTURE IMPLEMENTATION
# # Max number of new songs to look up on Tunebat per run
# # (songs already in the CSV cache are skipped and don't count toward this)
# ENRICHMENT_CAP=25

# # Random delay between Tunebat requests — be a polite visitor
# DELAY_MIN_MS=3000
# DELAY_MAX_MS=8000
